# Copy to .env for local development:  cp .env.example .env
# Every setting comes from the environment. Production values are in render.yaml (see DEPLOY.md).
# With APP_ENV=production the app refuses to start on unsafe values: secrets under 32 characters,
# an http:// FRONTEND_URL, or a remote DATABASE_URL without ?sslmode=require.

# development | production | testing  (defaults to production so debug is never on by accident)
APP_ENV=development
FLASK_DEBUG=1

# Generate real values with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me
JWT_SECRET_KEY=dev-only-jwt-secret-change-me-in-production

# Local docker compose Postgres. Neon: use the *pooled* string and keep ?sslmode=require.
DATABASE_URL=postgresql://kora:kora@localhost:5432/kora
# Used by pytest only. Never point this at a database you care about.
TEST_DATABASE_URL=postgresql://kora:kora@localhost:5432/kora_test

FRONTEND_URL=http://localhost:3000

# Rate limit storage. memory:// is fine for one process; use redis://... with several workers.
# Production refuses memory:// when WEB_CONCURRENCY (gunicorn workers) is more than 1.
# WEB_CONCURRENCY=1
RATELIMIT_STORAGE_URI=memory://
# Proxies in front of Flask (production: Vercel + Render = 2). Used to find the real client IP.
TRUSTED_PROXY_COUNT=0

# Admin account created by `flask seed` (password: at least 12 characters)
ADMIN_EMAIL=admin@kora.test
ADMIN_PASSWORD=local-admin-password

# Payment provider: "sandbox" (built-in fake checkout, no real money, works anywhere) or "stripe".
PAYMENT_PROVIDER=sandbox
# Signs sandbox webhooks (HMAC-SHA256). Generate: python -c "import secrets; print(secrets.token_hex(32))"
SANDBOX_WEBHOOK_SECRET=dev-sandbox-webhook-secret-change-me

# Stripe TEST mode only (live keys are refused at startup). Only used when PAYMENT_PROVIDER=stripe.
# Secret key: Stripe Dashboard > Developers > API keys (sk_test_...).
# Webhook secret: printed by `stripe listen` locally (whsec_...), or the dashboard endpoint in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional, for offline testing with stripe-mock: http://localhost:12111
STRIPE_API_BASE=

# --- Email (phase 8A, docs/guide/08a-email-notifications.md) ---
# log: write emails to the log, send nothing · mailpit: local fake inbox (docker compose) at
# http://localhost:8025 · resend: really send (production). Development defaults to mailpit.
EMAIL_PROVIDER=mailpit
# The From address. With Resend it must be on a domain you verified in Resend (DEPLOY.md, step 6).
EMAIL_FROM=Kora Outfitters <orders@kora.local>
# Resend API key (re_...), only used when EMAIL_PROVIDER=resend. Never commit a real one.
RESEND_API_KEY=
# Mailpit's SMTP port from docker-compose.yml
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
# New-ticket alerts go here, and customer emails use it as Reply-To. Locally any address works:
# Mailpit catches everything. (Not @example.com or @kora.test: those domains are never emailed.)
ADMIN_NOTIFY_EMAIL=owner@kora.local
# Bearer token for POST /api/email/outbox/process (the 5-minute retry job). Empty = endpoint off.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
OUTBOX_CRON_SECRET=
# Abuse limits: all emails per day (Resend's free tier allows 100) and per recipient per day.
EMAIL_DAILY_CAP=80
EMAIL_RECIPIENT_DAILY_CAP=10
# Guests' addresses aren't verified: at most this many guest-order confirmations per address per day.
EMAIL_GUEST_ORDER_DAILY_CAP=2

# --- Cloudflare Turnstile: the bot check on guest checkout (DEPLOY.md, step 10) ---
# Locally: Cloudflare's test secret, which accepts the test widget's token (still calls Cloudflare).
# Empty = check switched off. Production needs your real secret key (test keys are refused).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Phase 8: shared secret the AI agent sends in the X-Agent-Key header
AGENT_API_KEY=
