# Copy to .env for local development:  cp .env.example .env
# Every setting comes from the environment. On Render, set the same names in the dashboard.

# development | production | testing  (defaults to production so debug is never on by accident)
APP_ENV=development
FLASK_DEBUG=1

# Generate real values with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me
JWT_SECRET_KEY=dev-only-change-me-too

# Local docker compose Postgres. Neon: use the *pooled* string and keep ?sslmode=require.
DATABASE_URL=postgresql://kora:kora@localhost:5432/kora
# Used by pytest only. Never point this at a database you care about.
TEST_DATABASE_URL=postgresql://kora:kora@localhost:5432/kora_test

FRONTEND_URL=http://localhost:3000

# Phase 3: first admin account created by the seed command
ADMIN_EMAIL=admin@kora.test
ADMIN_PASSWORD=change-me

# Phase 4: Stripe test mode (sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 8: shared secret the AI agent sends in the X-Agent-Key header
AGENT_API_KEY=
