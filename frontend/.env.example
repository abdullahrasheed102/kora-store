# Copy to .env.local for local development:  cp .env.example .env.local

# The Flask backend. Server components call it directly; the browser reaches it through the /api rewrite.
BACKEND_URL=http://localhost:5000

# Public URL of this site, used for absolute links in metadata (Open Graph, canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The AI support assistant (Phase 8). Leave unset (or false) until the agent is live: the homepage
# then shows "Coming soon". NEXT_PUBLIC_ values are built into the page, so rebuild after changing it.
NEXT_PUBLIC_ASSISTANT_ENABLED=false

# --- Production (Vercel > Project > Settings > Environment Variables) ---
# BACKEND_URL=https://kora-api.onrender.com   (your Render URL, no trailing slash; set BEFORE the first build)
# NEXT_PUBLIC_SITE_URL=https://kora-outfitters.vercel.app
